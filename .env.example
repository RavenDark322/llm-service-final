# Скопируйте в .env и заполните. Файл .env в git НЕ попадает (.gitignore).

# Профиль конфигурации: dev (подробные логи) | prod (без текстов в логах, слушает 0.0.0.0)
APP_ENV=dev

# ---------- Провайдер GigaChat (по умолчанию) ----------
LLM_PROVIDER=gigachat
# Ключ авторизации (Authorization key) из личного кабинета developers.sber.ru
GIGACHAT_CREDENTIALS=
# Сертификат НУЦ Минцифры (см. certs/README.md)
GIGACHAT_CA_BUNDLE=certs/russian_trusted_root_ca.cer
LLM_MODEL=GigaChat-2

# ---------- Или любой OpenAI-совместимый API ----------
# LLM_PROVIDER=openai
# Ollama (локально, без ключа):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# OpenAI:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=

# ---------- Необязательные переопределения ----------
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=30
# CACHE_TTL=600
# PORT=8000
# LOG_LEVEL=INFO

# ---------- Фейковый LLM для проверки сбоев (scripts/fake_llm_server.py) ----------
# GIGACHAT_CREDENTIALS=fake
# GIGACHAT_AUTH_URL=http://127.0.0.1:8001/ok/api/v2/oauth
# GIGACHAT_BASE_URL=http://127.0.0.1:8001/ok/v1
